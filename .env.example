# LINE Bot 配置檔案
# LINE Bot Configuration File

# 從 LINE Developers Console 獲取以下資訊
# Get the following information from LINE Developers Console

# LINE Bot Channel Access Token (長期)
# LINE Bot Channel Access Token (Long-lived)
CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# LINE Bot Channel Secret
# LINE Bot Channel Secret
CHANNEL_SECRET=your_channel_secret_here

# 服務器端口 (可選，默認 3000)
# Server Port (Optional, default 3000)
PORT=3000

# 開發模式設置 (可選)
# Development Mode Settings (Optional)
NODE_ENV=development

# AI 功能配置
# AI Feature Configuration
# 從 Google AI Studio 獲取 API Key: https://makersuite.google.com/app/apikey
# Get API Key from Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 啟用 AI 功能 (true/false)
# Enable AI Features (true/false)
ENABLE_AI_FEATURES=true

# 網絡搜索功能開關 (可選)
# Web Search Feature Toggle (Optional)
# 如需使用真實搜索，請設置 Google Custom Search API
# To use real search, set up Google Custom Search API
ENABLE_WEB_SEARCH=false

# Google Custom Search API Key (可選，僅當 ENABLE_WEB_SEARCH=true 時需要)
# Google Custom Search API Key (Optional, only needed when ENABLE_WEB_SEARCH=true)
SEARCH_API_KEY=your_search_api_key_here

# Google Custom Search Engine ID (可選)
# Google Custom Search Engine ID (Optional)
SEARCH_ENGINE_ID=your_search_engine_id_here

# 除錯設置 (可選)
# Debug Settings (Optional)
DEBUG_AI=false